  @media (max-width: 520px) {
    .fn-icon { display: none; }
    .fn-hdr { font-size: 22px; padding-bottom: 6px; }
    .fn-dir { font-size: 17px; }
    .fn-next { font-size: 30px; }
    .fn-spaces { font-size: 17px; }
  }
