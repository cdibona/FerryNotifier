# Systemd service file for FerryNotifier
# Place this file in /etc/systemd/system/ferrynotifier.service
#
# Installation:
# 1. Copy this file: sudo cp deployment/ferrynotifier.service /etc/systemd/system/
# 2. Reload systemd: sudo systemctl daemon-reload
# 3. Enable service: sudo systemctl enable ferrynotifier
# 4. Start service: sudo systemctl start ferrynotifier
# 5. Check status: sudo systemctl status ferrynotifier

[Unit]
Description=FerryNotifier Washington State Ferry Status Webhook Server
Documentation=https://github.com/cdibona/FerryNotifier
After=network.target
Wants=network-online.target

[Service]
Type=simple

# User and group to run as (adjust as needed)
User=www-data
Group=www-data

# Working directory (adjust to your installation path)
WorkingDirectory=/opt/FerryNotifier/web

# Environment variables
Environment="PATH=/opt/FerryNotifier/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/FerryNotifier/.env

# Command to run (using gunicorn for production)
# Adjust the number of workers (-w) based on your server's CPU cores
# Formula: (2 x CPU cores) + 1
ExecStart=/opt/FerryNotifier/venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:5050 \
    --access-logfile /var/log/ferrynotifier/access.log \
    --error-logfile /var/log/ferrynotifier/error.log \
    --log-level info \
    --timeout 60 \
    app:app

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/ferrynotifier

# Resource limits
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
