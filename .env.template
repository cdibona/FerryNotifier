# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
FLASK_DEBUG=False

# WSDOT API Configuration
WSDOT_API_KEY=your_wsdot_api_key_here
WSDOT_API_BASE_URL=https://www.wsdot.wa.gov/ferries/api

# Ferry Configuration
# Route ID for the ferry route you want to display
# Common routes: 
#   - Seattle-Bainbridge: route ID
#   - Mukilteo-Clinton: route ID
#   - etc.
FERRY_ROUTE_ID=

# Trmnl Configuration
# Set this to your Trmnl device ID if needed for verification
TRMNL_DEVICE_ID=

# Site URL Configuration
# The base URL where this webhook server is accessible
# Used by the webhook simulator frontend
# Example: https://your-domain.com or http://localhost:5050
SITE_URL=

# Let's Encrypt SSL Configuration
# Domain name for the SSL certificate (e.g., ferry.yourdomain.com)
LETSENCRYPT_DOMAIN=
# Email address for Let's Encrypt registration and renewal notifications
LETSENCRYPT_EMAIL=

# Discord Webhook Configuration (optional)
# If set, API requests will be logged to this Discord channel
# Get webhook URL from Discord: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Vestaboard Configuration (optional)
# If set, GET/POST /api/vestaboard pushes ferry status to your Vestaboard
# (or Vestaboard Note) device using the Read/Write API.
# Get a Read/Write key from the Vestaboard app or https://web.vestaboard.com
VESTABOARD_RW_KEY=
# Override the endpoint if needed (defaults to the Read/Write API URL)
VESTABOARD_RW_URL=https://rw.vestaboard.com/

# Push scheduler
# When true, the server runs a background scheduler that pushes each enabled
# target (Vestaboard boards / TRMNL webhook devices) on its configured schedule.
# The Docker image sets this to true by default.
ENABLE_SCHEDULER=true

# Poll the WSDOT API at most once per this many seconds per route (shared cache).
# Default 300 (5 minutes).
WSDOT_CACHE_SECONDS=300

# Where persisted settings (targets, keys, schedules) are stored. In Docker this
# defaults to /app/data/settings.json — mount a volume there to keep it.
# SETTINGS_PATH=
