# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
FLASK_DEBUG=False

# WSDOT API Configuration
WSDOT_API_KEY=your_wsdot_api_key_here
WSDOT_API_BASE_URL=https://www.wsdot.wa.gov/ferries/api

# Ferry Configuration
# Route ID for the ferry route you want to display
# Common routes: 
#   - Seattle-Bainbridge: route ID
#   - Mukilteo-Clinton: route ID
#   - etc.
FERRY_ROUTE_ID=

# Trmnl Configuration
# Set this to your Trmnl device ID if needed for verification
TRMNL_DEVICE_ID=

# Site URL Configuration
# The base URL where this webhook server is accessible
# Used by the webhook simulator frontend
# Example: https://your-domain.com or http://localhost:5050
SITE_URL=

# Let's Encrypt SSL Configuration
# Domain name for the SSL certificate (e.g., ferry.yourdomain.com)
LETSENCRYPT_DOMAIN=
# Email address for Let's Encrypt registration and renewal notifications
LETSENCRYPT_EMAIL=
